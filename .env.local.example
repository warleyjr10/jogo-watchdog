# Redis da Vercel Marketplace (Upstash). A Vercel preenche estas duas ao conectar o Redis ao projeto.
# O app aceita também os nomes UPSTASH_REDIS_REST_URL e UPSTASH_REDIS_REST_TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Chave do host: protege os botões que controlam o jogo no telão. Escolha uma senha curta.
# Sem ela, qualquer pessoa que abrir o telão consegue controlar o jogo.
HOST_KEY=

NEXT_PUBLIC_APP_NOME=congresso-jogo-watchdog
